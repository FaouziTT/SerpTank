# =============================================================================
# SerpTank .gitignore
#
# NOTE: rules are deliberately scoped. A previous unscoped Python rule (`lib/`)
# silently excluded the entire `frontend/lib/` directory from version control.
# Never add bare directory names that could match source folders elsewhere.
# =============================================================================

# --- Secrets & environment ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
!infra/secrets/README.md

# --- Python (backend) --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
backend/.venv/
backend/venv/
backend/build/
backend/dist/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/.coverage.*
backend/htmlcov/
backend/coverage.xml
backend/logs/
backend/uploads/
celerybeat-schedule*

# --- Node / Next.js (frontend) -----------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/.vercel
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- Tooling / OS / IDE --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.log
.playwright-mcp/
.claude/settings.local.json

# --- Local databases & scratch -----------------------------------------------
*.db
*.sqlite
*.sqlite3
cookies.txt
tmp/
*.tmp

# Deployment-local config on the server (env files, current release marker).
/config/
