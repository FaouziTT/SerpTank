# Non-secret SerpTank settings for production (copy to ./config/app.env on the host).
# Secrets never go here: they are Docker secret files under ./secrets/ (see
# docs/runbooks/deploy.md). Every key is optional unless noted.
SERPTANK_ENCRYPTION_ACTIVE_KEY_ID=k1            # required: id of the active key in the keyring
SERPTANK_GOOGLE_CLIENT_ID=                      # Sign in with Google
SERPTANK_GOOGLE_DATA_CLIENT_ID=                 # Search Console / Analytics connections
SERPTANK_DATAFORSEO_LOGIN=
SERPTANK_SERP_VENDOR_ORDER=*=dataforseo
SERPTANK_SERP_GLOBAL_DAILY_REQUESTS=20000
SERPTANK_OPENAI_MODEL=gpt-4.1-mini
SERPTANK_STRIPE_PRICES=                         # pro=price_..,agency=price_..,engines_bing=price_..
SERPTANK_PRICING_DISPLAY=                       # pro=49,agency=199 (display only)
SERPTANK_TURNSTILE_SITE_KEY=
