[Unit]
Description=SerpTank encrypted database backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=serptank
EnvironmentFile=/opt/serptank/config/backup.env
ExecStart=/opt/serptank/infra/backup/backup.sh
# Hardening for the unit itself.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/tmp
