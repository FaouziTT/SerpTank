# ===================================================
# VOLTEX SEO DECISION SUPERIORITY ENGINE - API CONFIGURATION
# ===================================================

# ===================================================
# GOOGLE APIS CONFIGURATION
# ===================================================

# Google Programmable Search API (for SERP analysis)
GOOGLE_PROGRAMMABLE_SEARCH_API_KEY=your-programmable-search-api-key
GOOGLE_PROGRAMMABLE_SEARCH_ENGINE_ID=your-search-engine-id

# PageSpeed Insights API (for Core Web Vitals and technical SEO)
GOOGLE_PAGESPEED_API_KEY=your-pagespeed-api-key

# Google Analytics 4 Data API (for revenue tracking and profitability analysis)
# Using Service Account Authentication
GOOGLE_ANALYTICS_PROPERTY_ID=your-ga4-property-id
GOOGLE_APPLICATION_CREDENTIALS=/app/your-service-account-key.json

# YouTube Data API (uses same key as PageSpeed Insights)
YOUTUBE_DATA_API_KEY=your-youtube-api-key  # Optional: can use GOOGLE_PAGESPEED_API_KEY

# Google Trends API (no key required - uses pytrends library)
GOOGLE_TRENDS_ENABLED=true

# ===================================================
# ADVANCED SEO APIS
# ===================================================

# SerpAPI for advanced SERP analysis and competitor research
SERPAPI_KEY=your-serpapi-key

# OpenAI API for content generation and AI-powered SEO insights
OPENAI_API_KEY=your-openai-api-key

# ===================================================
# SOCIAL MEDIA APIS
# ===================================================

# Twitter/X API v2 Configuration
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Facebook Graph API Configuration
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# LinkedIn API Configuration
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ===================================================
# PREMIUM SEO TOOLS (Optional - for future expansion)
# ===================================================

# SEMrush API (requires paid subscription)
# SEMRUSH_API_KEY=your-semrush-api-key

# Ahrefs API (requires paid subscription)
# AHREFS_API_KEY=your-ahrefs-api-key

# Moz API (requires paid subscription)
# MOZ_ACCESS_ID=your-moz-access-id
# MOZ_SECRET_KEY=your-moz-secret-key

# ===================================================
# WEBSITE CONFIGURATION
# ===================================================

# Your primary website to analyze (used as default for analysis)
DEFAULT_SITE_URL=https://yourwebsite.com
DEFAULT_SITE_PROPERTY=sc-domain:yourwebsite.com

# ===================================================
# API SETUP GUIDE
# ===================================================

# 1. GOOGLE APIS:
#    - Go to Google Cloud Console (console.cloud.google.com)
#    - Create a new project or select existing
#    - Enable the following APIs:
#      * Custom Search API
#      * PageSpeed Insights API
#      * Google Analytics Data API
#      * YouTube Data API v3
#      * Google Search Console API
#    - Create API keys and service account credentials
#    - Download service account JSON file

# 2. SERPAPI:
#    - Sign up at serpapi.com
#    - Get your API key from dashboard

# 3. OPENAI:
#    - Sign up at platform.openai.com
#    - Create API key in API settings

# 4. TWITTER/X API:
#    - Apply for Twitter Developer account
#    - Create a new app in Twitter Developer Portal
#    - Generate Bearer Token and API credentials

# 5. FACEBOOK API:
#    - Create Facebook Developer account
#    - Create a new app and get access token
#    - Add your Facebook page

# 6. LINKEDIN API:
#    - Create LinkedIn Developer account
#    - Create a new app and get OAuth credentials

# ===================================================
# NOTES
# ===================================================

# - Not all APIs are required for basic functionality
# - Google APIs (Search, PageSpeed, Analytics, GSC) provide core SEO data
# - Social Media APIs enhance brand monitoring and social signals analysis
# - Premium SEO tool APIs (SEMrush, Ahrefs) can be added later for advanced features
# - Make sure to set appropriate API quotas and monitor usage to avoid overages
