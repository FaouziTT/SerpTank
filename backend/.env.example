# Voltex Backend Environment Configuration
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security Keys (REQUIRED - Generate secure keys for production!)
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_YOUR_GENERATED_KEY

# Generate FIELD_ENCRYPTION_KEY with: 
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_THIS_TO_YOUR_GENERATED_KEY

# Admin User (REQUIRED - minimum 12 characters)
FIRST_SUPERUSER=admin@voltex.local
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_MIN_12_CHARS
ADMIN_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_MIN_12_CHARS

# Database Configuration (REQUIRED)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=voltex
POSTGRES_PORT=5432

# Redis Configuration (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS Configuration for local development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Voltex

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (for redirects and CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (Optional)
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@voltex.local
EMAILS_FROM_NAME=Voltex

# External Service API Keys (Optional - can leave empty for basic functionality)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
SERPAPI_API_KEY=
SERPAPI_KEY=  # Alternative key name
GOOGLE_MAPS_API_KEY=
GOOGLE_PSE_ID=
GOOGLE_PSE_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_DATA_API_KEY=  # Alternative key name

# Social Media API Keys (Optional)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_BEARER_TOKEN=  # Alternative key name
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=  # Alternative key name
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=  # Alternative key name

# Stripe Configuration (Optional)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=60

# Cache Configuration
CACHE_TTL=3600
ENABLE_CACHE_WARMING=false

# Development specific
RELOAD=true