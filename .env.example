# SerpTank local development environment.
# Copy to `.env` (git-ignored) and replace every value. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Production secrets are NOT kept in env files: they are sops-encrypted and mounted
# as Docker secrets (see docs/execution-plan.md §5.4, Module 14).

ENVIRONMENT=development

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_USER=serptank
POSTGRES_PASSWORD=change-me-generate-a-random-value
POSTGRES_DB=serptank
POSTGRES_PORT=5432
# Login role used by the API (serptank_api, RLS-enforced) and by schedulers (serptank_sched).
POSTGRES_APP_PASSWORD=change-me-generate-a-random-value
POSTGRES_SCHED_PASSWORD=change-me-generate-a-random-value

# --- Redis (docker-compose.dev.yml) ---
REDIS_PASSWORD=change-me-generate-a-random-value
REDIS_PORT=6379

# Application settings (secret keys, integrations, providers) are introduced by
# Module 1 onwards; each module documents the variables it adds.

# --- Jobs, crawler, renderer (Module 6) - optional in development ---
# SERPTANK_JOBS_BACKEND=inprocess            # "celery" in staging/production
# SERPTANK_SCHEDULER_DATABASE_URL=           # serptank_sched login (BYPASSRLS) for beat
# SERPTANK_RENDERER_URL=http://127.0.0.1:8100
# SERPTANK_RENDERER_TOKEN=                   # >= 32 random bytes

# --- Integrations (Module 7) - optional; features stay off (and say so) when unset ---
# SERPTANK_GOOGLE_DATA_CLIENT_ID=            # OAuth client for GSC/GA4/Ads (not the sign-in client)
# SERPTANK_GOOGLE_DATA_CLIENT_SECRET=
# SERPTANK_GOOGLE_API_KEY=                   # CrUX / PageSpeed Insights
# SERPTANK_GOOGLE_ADS_DEVELOPER_TOKEN=       # Keyword Planner (Basic Access)
# SERPTANK_GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Search data engine (Module 8) - optional; live SERP checks stay off when unset ---
# SERPTANK_DATAFORSEO_LOGIN=
# SERPTANK_DATAFORSEO_PASSWORD=
# SERPTANK_RAWHTML_ENDPOINT=https://vendor.example/?api_key={key}&url={url}&country={country}
# SERPTANK_RAWHTML_API_KEY=
# SERPTANK_SERP_VENDOR_ORDER=*=dataforseo,rawhtml
# SERPTANK_SERP_GLOBAL_DAILY_REQUESTS=20000
# SERPTANK_SERP_VALIDATION_RATE=0.02

# --- LLM gateway (Modules 9-10) - optional; AI suggestions stay off when unset ---
# SERPTANK_OPENAI_API_KEY=
# SERPTANK_OPENAI_MODEL=gpt-4.1-mini
# SERPTANK_LLM_ENABLED=true                   # global kill switch
# SERPTANK_OPENAI_SEARCH_MODEL=gpt-4.1-mini    # ChatGPT answer sampling (web_search tool)
# SERPTANK_PERPLEXITY_API_KEY=                # Perplexity answer sampling (Sonar)
# SERPTANK_PERPLEXITY_MODEL=sonar

# --- Billing (Module 12) - optional; the billing page says "not configured" when unset ---
# SERPTANK_STRIPE_SECRET_KEY=                 # restricted key recommended
# SERPTANK_STRIPE_WEBHOOK_SECRET=             # whsec_... for /api/v1/billing/stripe/webhook
# SERPTANK_STRIPE_PRICES=pro=price_...,agency=price_...,engines_bing=price_...,engines_regional=price_...
# SERPTANK_BILLING_GRACE_DAYS=7
# SERPTANK_PRICING_DISPLAY=pro=49,agency=199,engines_bing=19   # public pricing page (display only)
# SERPTANK_PRICING_CURRENCY=USD

# --- Compliance and public site (Module 13) ------------------------------------------
# SERPTANK_TURNSTILE_SITE_KEY=                # public key; pairs with SERPTANK_TURNSTILE_SECRET
# SERPTANK_DELETION_GRACE_DAYS=30
# Read by the web (Next.js) server for the marketing and legal pages. When unset, the
# legal pages say the operator details are missing and security.txt returns 404.
# SERPTANK_SITE_URL=https://app.example.com
# SERPTANK_LEGAL_ENTITY=Example Ltd
# SERPTANK_LEGAL_ADDRESS=1 Example Street, City, Country
# SERPTANK_LEGAL_JURISDICTION=England and Wales
# SERPTANK_PRIVACY_EMAIL=privacy@example.com
# SERPTANK_SECURITY_EMAIL=security@example.com
