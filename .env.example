# Voltex SEO Decision Superiority Engine - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================

# JWT Secret Key - MUST be a persistent, secure random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-persistent-secret-key-here-change-this-in-production

# Admin User Configuration - REQUIRED for initial setup
ADMIN_PASSWORD=your-secure-admin-password-at-least-12-characters

# SSL/TLS Configuration
SSL_ENABLED=false
# SSL_CERT_PATH=/path/to/certificate.crt
# SSL_KEY_PATH=/path/to/private.key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_DB=voltex
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# EXTERNAL API KEYS (OPTIONAL - Features will be limited without these)
# =============================================================================

# Google APIs - For Search Console, Analytics, Trends, YouTube
GOOGLE_PAGESPEED_API_KEY=your-google-api-key
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_ANALYTICS_CLIENT_ID=your-google-analytics-client-id
GOOGLE_ANALYTICS_CLIENT_SECRET=your-google-analytics-client-secret
GOOGLE_ANALYTICS_PROPERTY_ID=your-ga4-property-id
GOOGLE_TRENDS_ENABLED=true
YOUTUBE_DATA_API_KEY=your-youtube-api-key

# OpenAI API - For AI-powered content features (Pillars 4-6)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# SerpAPI - For keyword research and SERP analysis
SERPAPI_KEY=your-serpapi-key

# Social Media APIs
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================

# Vector Database Type: "pinecone" or "weaviate"
VECTOR_DB_TYPE=weaviate
VECTOR_DB_URL=http://localhost:8080

# Pinecone Configuration (if using Pinecone)
# VECTOR_DB_API_KEY=your-pinecone-api-key
# VECTOR_DB_ENVIRONMENT=your-pinecone-environment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# CORS Origins - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Allowed Hosts - Comma-separated list of allowed host headers
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging Level
LOG_LEVEL=INFO

# Crawler Configuration
CRAWLER_USER_AGENT=VoltexBot/1.0 (+https://voltex.ai/bot)
CRAWLER_CONCURRENCY=5
CRAWLER_RESPECT_ROBOTS_TXT=true

# Default Site Configuration
DEFAULT_SITE_URL=
DEFAULT_SITE_PROPERTY=

# SEO Analysis Configuration
SEO_ANALYSIS_DEPTH=10
KEYWORD_RESEARCH_LIMIT=100

# =============================================================================
# DEVELOPMENT/PRODUCTION ENVIRONMENT
# =============================================================================

# Environment type: development, staging, production
ENVIRONMENT=development

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Generate a secure SECRET_KEY (see comment above)
# 3. Set a strong ADMIN_PASSWORD (minimum 12 characters)
# 4. Configure database credentials
# 5. Add external API keys as needed for features you want to use
# 6. For production: Set SSL_ENABLED=true and configure certificate paths
# 7. For production: Update CORS_ORIGINS and ALLOWED_HOSTS to your domains

# =============================================================================
# GOOGLE API SETUP GUIDE
# =============================================================================

# To get Google API credentials:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project or select existing project
# 3. Enable APIs: Search Console API, Analytics Reporting API, PageSpeed Insights API
# 4. Create credentials:
#    - For OAuth: Create OAuth 2.0 Client ID
#    - For PageSpeed: Create API Key
# 5. For OAuth credentials, add your redirect URIs:
#    - http://localhost:8000/api/v1/oauth/google/callback (development)
#    - https://yourdomain.com/api/v1/oauth/google/callback (production)

# =============================================================================
# OPENAI API SETUP GUIDE
# =============================================================================

# To get OpenAI API key:
# 1. Go to https://platform.openai.com/
# 2. Create an account or log in
# 3. Go to API Keys section
# 4. Create a new secret key
# 5. Add billing information to your account
# 6. Set usage limits to control costs

# =============================================================================
# DOCKER DEVELOPMENT SETUP
# =============================================================================

# For Docker development, use these values:
# POSTGRES_SERVER=postgres
# REDIS_HOST=redis
# VECTOR_DB_URL=http://weaviate:8080

# To start with Docker:
# docker-compose up -d

# =============================================================================
# SECURITY NOTES
# =============================================================================

# NEVER commit .env files to version control
# Use different SECRET_KEY for each environment
# Rotate API keys regularly
# Use strong passwords for database and admin accounts
# Enable SSL/TLS in production
# Restrict CORS_ORIGINS and ALLOWED_HOSTS in production
# Monitor API usage and set up alerts
# Regularly review and update credentials